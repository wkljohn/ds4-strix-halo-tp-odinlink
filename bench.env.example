# Copy to bench.env.local and edit. Both nodes need this repository and the
# model at the same absolute paths; their filesystems are independent.
: "${DS4_PEER_MGMT:=user@node2-management-address}"
: "${DS4_PEER_HOST_KEY_ALIAS:=node2-rdma}"
: "${DS4_PEER_REPO:=/absolute/path/ds4-strix-halo-tp-odinlink}"
: "${DS4_COORDINATOR_ADDR:=10.4.0.1}"
: "${DS4_BENCH_OUT:=/absolute/path/ds4-strix-halo-tp-odinlink/research-results/bench-runs}"

# OdinLink profile (the default).
: "${DS4_BENCH_RDMA_PROFILE:=odinlink}"
: "${DS4_ODINLINK_ROOT:=/absolute/path/OdinLink-Five}"
: "${DS4_LOCAL_RDMA_DEVICE:=odl_tb5_0}"
: "${DS4_PEER_RDMA_DEVICE:=odl_tb5_0}"

# For RoCE v2, replace the active OdinLink values above with these settings:
# : "${DS4_BENCH_RDMA_PROFILE:=roce-v2}"
# : "${DS4_COORDINATOR_ADDR:=192.168.99.1}"
# : "${DS4_LOCAL_RDMA_DEVICE:=mlx5_0}"
# : "${DS4_PEER_RDMA_DEVICE:=mlx5_1}"
# : "${DS4_RDMA_GID_INDEX:=3}"

# Required only when DS4_BENCH_DSPARK=1. There is deliberately no private or
# machine-specific drafter default in the public launcher.
# DS4_BENCH_MTP=/absolute/path/dspark-DeepSeek-V4-Flash-0731-Q8_0.gguf
