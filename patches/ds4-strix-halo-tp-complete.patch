+    if (in_count > 8192u) {
+        fprintf(stderr, DS4_GPU_LOG_PREFIX
+                "q8_0 kslice: slice %llu exceeds the shared-x LDS budget\n",
+                (unsigned long long)in_count);
+        return 0;
+    }
+    const char *wptr = cuda_model_range_ptr(model_map, weight_offset, weight_bytes,
+                                            "q8_0_kslice");
