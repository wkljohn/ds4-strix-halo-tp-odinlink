# Copy to config.env.local and use absolute paths that exist on both nodes.
MODEL=/absolute/path/DeepSeek-V4-Flash-Q4_K.gguf
# Pin the coordinator executable after the final build. The launcher refuses
# a stale ds4-server because the prefill wavefront changes the TP gate schedule.
# DS4_SERVER_SHA256=$(sha256sum ./ds4-server | awk '{print $1}')
DS4_SERVER_SHA256=replace-with-64-hex-ds4-server-sha256
# Ordinary exact decode is the production default. DSpark remains an
# experimental opt-in until it matches the target-only token fingerprint.
DSPARK=0
# Required only when DSPARK=1.
MTP=/absolute/path/DeepSeek-V4-Flash-DSpark-support-Q8_0.gguf

# Management SSH is separate from the OdinLink/RDMA data path.
PEER_MGMT=user@peer-management-address
PEER_HOST_KEY_ALIAS=peer-rdma-host-key-alias
COORDINATOR_RDMA_ADDR=10.4.0.1

# Transport profile: odinlink (default), roce-v2, or ib-mlx4. For the
# reference ConnectX-4 Lx pair, use the RoCE v2 values below and set
# COORDINATOR_RDMA_ADDR to 192.168.99.1. For a direct ConnectX-3 (mlx4)
# InfiniBand cable, use the ib-mlx4 values; a subnet manager (opensm) must
# run on one node, and device names come from `ibv_devinfo -l`.
RDMA_PROFILE=odinlink
# LOCAL_RDMA_DEVICE=mlx5_0
# PEER_RDMA_DEVICE=mlx5_1
# RDMA_GID_INDEX=3
# LOCAL_RDMA_DEVICE=ibp195s0
# PEER_RDMA_DEVICE=ibp195s0
# RDMA_GID_INDEX=0

# Both independent filesystems must contain this repository at this path.
PEER_REPO=/absolute/path/ds4-strix-halo-tp-odinlink
ODINLINK_ROOT=/absolute/path/OdinLink-Five
# Research output lives outside every Git worktree. The peer may use a
# different absolute path because the two filesystems are independent.
DS4_RESEARCH_ROOT=/absolute/path/research-results
DS4_PEER_RESEARCH_ROOT=/absolute/path/research-results

# 256 Ki tokens, one resident API session, localhost behind Caddy.
CONTEXT=262144
# 2048 keeps the 256K KV allocation, and the optional resident drafter, within 96 GiB.
PREFILL_CHUNK=2048
# Optional override. The launcher defaults to 128 for ordinary inference and
# 118 for DSpark (approximately a 46/54 node split).
# EXPERT_SPLIT=128
# Ordinary non-DSpark inference enables both validated prefill improvements.
# Set either value to 0 on both ranks through this launcher for rollback.
PREFILL_FFN_WAVEFRONT=1
Q8_M256_K128=1
# Exact cooperative HC decode is useful at every validated context. The radix
# tree engages only after 8,192 compressed rows (about 32K input tokens).
HC_STAGE_EXACT_COOP=1
INDEXER_TOPK_RADIX_TREE=1
# Validated ordinary-inference defaults. Set these legacy-compatible launcher
# values to 0 for a symmetric rollback on both ranks.
Q4K_KSHARD_RESEARCH=1
ATTN_DECODE_SEQTILE_RESEARCH=8
# Per-exchange deadline. Long prompts get a fresh deadline for every gate.
TP_TIMEOUT_SEC=60
# Greedy is deterministic. Explicit request temperatures still override it.
DEFAULT_TEMPERATURE=0
TP_PORT=9000
API_HOST=127.0.0.1
API_PORT=8090
